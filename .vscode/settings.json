{
    // 절대경로였던 것을 ${workspaceFolder}로 — GPU PC는 홈 디렉토리 경로가 다르다
    // od_msg 는 2026-08-08 정리로 삭제됨. 남은 유일한 ament_cmake 패키지가 pick_fsm_msgs 다
    "cmake.sourceDirectory": "${workspaceFolder}/src/pick_fsm_msgs",

    // isaac_ros-dev(136MB·수천 파일)와 colcon 산출물을 파일 감시·검색에서 제외한다.
    // 제외하지 않으면 VS Code가 파일 워처 한도(inotify)를 넘겨 Source Control 패널이 느려지거나 멈춘다.
    "files.watcherExclude": {
        "**/isaac_ros-dev/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true,
        "**/__pycache__/**": true
    },
    "search.exclude": {
        "**/isaac_ros-dev/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/log/**": true
    },

    "git.autofetch": true
}
